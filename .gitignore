# Godot
.godot/
*.import
# ...but DO track aircraft model import settings (keep-mode glb fix must reach all platforms)
!provpilot/aircraft/*/model/*.glb.import
!provpilot/aircraft/*/model/liveries/**/*.png.import
# ...and the sound sets: FGSounds reads the raw .wav from the installed aircraft folder
!provpilot/aircraft/*/sounds/*.wav.import

# Build artifacts
*.o
*.os
*.a
*.dylib
*.so
*.dll
.sconsign.dblite

# macOS
.DS_Store
*.dSYM/

# IDE
.vscode/
*.swp
*.swo
*~

# Compiled binaries (keep in bin/ for distribution)
libprovpilot.macos.template_debug.arm64.dylib
libprovpilot.macos.template_release.arm64.dylib
libprovpilot.linux.template_debug.x86_64.so
libprovpilot.linux.template_release.x86_64.so

# JSBSim build artifacts
jsbsim/build/

# Python
__pycache__/
*.pyc

# Godot UID files (auto-generated)
*.uid

# Terrain data (large files, can be regenerated from R16 source)
provpilot/Terra3DData/
provpilot/terrain_data/
provpilot/terrain_tiles/
*.r16
*.exr
*.hdr
*.raw.aux.xml

# Terrain cache (downloaded SwissTopo TIFs - regenerate with scripts)
terrain_cache/

# Scenery data (large binary files — terrain .raw, building/road/water .glb)
# Manifests and metadata JSON files ARE tracked.
scenery/terrain/*.raw
scenery/terrain/distant_terrain_color.png
scenery/terrain/distant_terrain_color.elevation.png
scenery/buildings/*.glb
scenery/roads/*.glb
scenery/water/*.glb
scenery/custom/*/

# Orthophoto tiles (large, ~13 GB — regenerate with scripts)
scenery/orthophoto/*.jpg
scenery/orthophoto_hires/*.jpg

# Building source data (large GDB files - keep only Schaffhausen)
# Zurich area tiles (1031-*, 1032-*, 1071-*)
provpilot/buildings_data/swissbuildings3d_3_0_*_1031-*
provpilot/buildings_data/swissbuildings3d_3_0_*_1032-*
provpilot/buildings_data/swissbuildings3d_3_0_*_1071-*
provpilot/buildings_data/swissbuildings3d_3_0_*_1072-*
provpilot/buildings_data/test_tile*

# Zurich Airport buildings (GLB) - exclude for now
provpilot/Assets/buildings/

# Keep only Schaffhausen buildings (1091-*, 1092-*)
# provpilot/buildings_data/swissbuildings3d_3_0_*_1091-*
# provpilot/buildings_data/swissbuildings3d_3_0_*_1092-*
# provpilot/Assets/buildings_schaffhausen/
build/
.venv/

# Remote LLM delegation config (contains API key) + call log (usage/quality stats)
scripts/.llm_remote.env
scripts/.llm_remote.log.jsonl

# Copernicus Data Space credentials (S3 keys + account login)
scripts/.copernicus.env
