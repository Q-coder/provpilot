[configuration]

entry_symbol = "gojsb_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

macos.debug = "res://bin/libprovpilot.macos.template_debug.double.arm64.dylib"
macos.release = "res://bin/libprovpilot.macos.template_release.double.arm64.dylib"
windows.debug.x86_64 = "res://bin/libprovpilot.windows.template_debug.double.x86_64.dll"
windows.release.x86_64 = "res://bin/libprovpilot.windows.template_release.double.x86_64.dll"
linux.debug.x86_64 = "res://bin/libprovpilot.linux.template_debug.double.x86_64.so"
linux.release.x86_64 = "res://bin/libprovpilot.linux.template_release.double.x86_64.so"
linux.debug.arm64 = "res://bin/libprovpilot.linux.template_debug.double.arm64.so"
linux.release.arm64 = "res://bin/libprovpilot.linux.template_release.double.arm64.so"
